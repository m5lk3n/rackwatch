[dashboard]
refresh_seconds = 30
stale_after = "300s"
down_after = "12h"
theme = "default"
show_sparklines = true
# "auto", "eighths", "halves" or "line"; auto uses line on the Linux text console
spark_glyphs = "auto"
# one row per metric instead of stretching panels to fill the screen
condensed = false
# rows and columns hidden by the screen's bezel
margin_top = 1
margin_bottom = 0
margin_left = 5
margin_right = 4

[screensaver]
# digital rain from The Matrix; any key or touch ends it early
enabled = true
interval = "5m"
duration = "10s"

[blackout]
# black screen in this period (local time); a key or touch shows the dashboard for a minute
enabled = true
from = "23:00"
until = "08:00"

[telegram]
# message a chat when a host goes down or recovers; see README for setup
enabled = false
bot_token = "123456789:ABC-your-token-from-BotFather"
chat_id = 123456789 # or "@channelname"
# no messages in this period (local time); outages still going when it ends are sent then
quiet_from = "23:00"
quiet_until = "08:00"

[touch]
# read a touchscreen directly, for the Linux text console, where taps don't reach rackwatch otherwise;
# find the device with: ls /dev/input/by-id/ (the one ending in -event-if00, or check with evtest);
# the user running rackwatch must be in the input group, see "Touchscreen" in the README
enabled = false
device = "/dev/input/by-id/usb-wch.cn_TouchScreen_9LQ0172005164-event-if00"
# if taps land in the wrong place: the touchscreen is turned against the display, or mirrored
swap_xy = false
invert_x = false
invert_y = false

[thresholds]
cpu_warning = 80
memory_warning = 85
disk_warning = 90
temperature_warning = 75 # celcius

[[hosts]]
name = "rackbox-01"
metrics_source = "local"

[[hosts]]
name = "rackbox-02"
metrics_source = "http://rackbox-02.internal:9100/metrics"

[[hosts]]
name = "rackbox-03"
metrics_source = "http://rackbox-03.internal:9100/metrics"
# set to false to hide a host without deleting it
enabled = true
